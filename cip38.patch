 3 files changed, 113 insertions(+), 113 deletions(-)
 create mode 100644 arch/arm/boot/dts/socfpga_cyclone5_de0_nano_soc.dts
 delete mode 100644 arch/arm/boot/dts/socfpga_cyclone5_de0_sockit.dts

